# ------------------------------
# Serveur
# ------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------
# API Backend
# ------------------------------

# ------------------------------
# MongoDB
# ------------------------------
# MongoDB Atlas ou local
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=ClusterName
# Si tu utilises MongoDB local
# MONGO_URI=mongodb://localhost:27017/mydatabase

# ------------------------------
# JWT Auth
# ------------------------------
JWT_SECRET=your_jwt_secret_key_here_use_openssl_rand_base64_32
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_use_openssl_rand_base64_32
REFRESH_TOKEN_EXPIRES_IN=30d

# ------------------------------
# Nodemailer (envoi d'emails)
# ------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_specific_password_here # Pour Gmail : mot de passe d'application
EMAIL_FROM="Your App Name"

# ------------------------------
# Options supplémentaires
# ------------------------------
CORS_ORIGIN=http://localhost:3000   # ton frontend
LOG_LEVEL=debug                     # ou 'info', 'warn', 'error'
